<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ BOTONES ============ -->

    <style name="SoftbarButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_600</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/brand_700</item>
    </style>

    <style name="SoftbarButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_600</item>
        <item name="strokeColor">@color/brand_600</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="SoftbarButton.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="SoftbarButton.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ============ CARDS ============ -->

    <style name="SoftbarCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_0</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="SoftbarCard.Module" parent="SoftbarCard">
        <item name="cardElevation">3dp</item>
        <item name="contentPadding">0dp</item>
        <item name="rippleColor">@color/brand_100</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ============ TIPOGRAFIA ============ -->

    <style name="Text" />

    <style name="Text.Display">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Eyebrow">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ============ INPUTS ============ -->

    <style name="SoftbarInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_600</item>
        <item name="hintTextColor">@color/brand_600</item>
    </style>
</resources>
